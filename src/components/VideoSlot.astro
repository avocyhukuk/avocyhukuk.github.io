---
/**
 * Video alanı — CLAUDE.md Bölüm 4/2.
 *
 * Site sahibi ileride her ana bölüme yapay zekâ araçlarıyla üretilmiş tanıtım
 * videoları ekleyecek. Kural: video geldiğinde sayfa YENİDEN TASARLANMAYACAK,
 * yalnızca bu konteynere video konacak.
 *
 * Bunu mümkün kılan şey, yüksekliğin `aspect-ratio` ile ÖNCEDEN rezerve
 * edilmesi: alan, video henüz yokken de tam olarak videonun kaplayacağı yeri
 * kaplar. Böylece video eklendiğinde düzen kaymaz (CLS = 0).
 *
 * Kullanım:
 *   <VideoSlot title="Ceza hukuku süreci" />                    → yer tutucu
 *   <VideoSlot title="..." src="https://www.youtube.com/embed/ID" />  → gömülü video
 */

interface Props {
  /**
   * Videonun erişilebilir adı. Yer tutucu hâlde de zorunlu — alanın hangi
   * bölüme ait olduğunu ekran okuyucuya ve sonraki geliştiriciye söyler.
   */
  title: string;
  /** Gömme adresi (YouTube/Vimeo embed URL'i). Boşsa yer tutucu gösterilir. */
  src?: string;
  /** Video yüklenene kadar gösterilecek görsel. */
  poster?: string;
  /** Videonun altına düşülecek açıklama. */
  caption?: string;
  class?: string;
}

const { title, src, poster, caption, class: className } = Astro.props;
---

<figure class:list={['video-slot', className]}>
  <div class="video-frame">
    {
      src ? (
        <iframe
          src={src}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : poster ? (
        <img src={poster} alt={title} loading="lazy" decoding="async" />
      ) : (
        /* Yer tutucu: aria-hidden değil — alanın var olduğu bilgisi doğru,
           ama dekoratif olduğu için metin ekran okuyucuya sade geçiyor. */
        <div class="video-placeholder">
          <span class="video-placeholder__label">Video alanı</span>
          <span class="video-placeholder__title">{title}</span>
        </div>
      )
    }
  </div>
  {caption && <figcaption class="video-caption">{caption}</figcaption>}
</figure>

<style>
  .video-slot {
    margin: 0;
  }

  /* .video-frame'in kendisi global.css'te tanımlı (aspect-ratio + taşma) */

  .video-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    height: 100%;
    padding: var(--space-5);
    text-align: center;
  }

  .video-placeholder__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .video-placeholder__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--brand-navy);
  }

  .video-caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
