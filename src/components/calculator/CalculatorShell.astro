---
/**
 * Hesaplama araçlarının ortak sayfa iskeleti.
 *
 * Sekiz aracın da (CLAUDE.md Bölüm 6) aynı çerçeveyi paylaşması için var:
 * yol göstergesi, başlık, form sütunu, hesap cetveli, zorunlu uyarı ve
 * iletişim bloğu. Araç yalnızca kendi form alanlarını ve hesap betiğini
 * getirir; çerçeveyi yeniden kurmaz.
 *
 * ZORUNLU UYARI: `CALCULATOR_DISCLAIMER` bu bileşende basılıyor ve prop ile
 * kapatılamıyor. CLAUDE.md Bölüm 4/3 bunu şart koşuyor — kabuktan geçen her
 * araç uyarıyı taşımak zorunda, unutulması mümkün değil.
 *
 * MEVZUAT TARİHİ: `lawAsOf` zorunlu bir prop. Hesabın hangi tarihli mevzuata
 * göre yapıldığı sonuçla birlikte görünmezse, mevzuat değiştiğinde araç
 * sessizce yanlış hâle gelir. İnfaz mevzuatı beş yılda üç kez değişti
 * (7242/2020, 7456/2023, 7550/2025) — bu alan süs değil.
 *
 * Kullanım:
 *   <CalculatorShell calculator={tool} lawAsOf="26 Ağustos 2026">
 *     <Fragment slot="form"> …FormField'lar + Hesapla butonu… </Fragment>
 *     <ResultSheet />
 *   </CalculatorShell>
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCallout from '../../components/ContactCallout.astro';
import { CALCULATOR_DISCLAIMER } from '../../lib/site';
import { breadcrumbSchema, type BreadcrumbItem } from '../../lib/schema';
import type { Calculator } from '../../lib/calculators';

interface Props {
  /** `CALCULATORS` içindeki kayıt — başlık, özet ve adres tek kaynaktan gelir. */
  calculator: Calculator;
  /**
   * Hesabın dayandığı mevzuatın son kontrol edildiği tarih.
   * Ör. `26 Ağustos 2026`. Sonuç alanının altında görünür.
   */
  lawAsOf: string;
  /**
   * Aracın neyi hesaplamadığını söyleyen kapsam notu.
   *
   * Zorunlu uyarıdan (`CALCULATOR_DISCLAIMER`) ayrı bir iş yapıyor: uyarı
   * "bu sonuç bağlayıcı değil" der, kapsam notu ise "senin durumun bu
   * aracın kapsamına girmiyor olabilir" der. İkincisi olmadan kullanıcı,
   * hesaplanmayan bir hâlde de doğru sonuç aldığını sanır.
   *
   * Ör. infaz aracı v1'inde: 18 yaş üstü, tek ilam, açık kuruma geçiş yok.
   */
  scopeNote?: string;
  /** Formun üstündeki kısa yönerge. */
  formTitle?: string;
}

const { calculator, lawAsOf, scopeNote, formTitle = 'Bilgileri girin' } = Astro.props;

const path = `/hesaplama-araclari/${calculator.slug}`;

const crumbs: BreadcrumbItem[] = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Hesaplama Araçları', path: '/hesaplama-araclari' },
  { name: calculator.title, path },
];

const message = `Merhaba, ${calculator.title} aracıyla ilgili bilgi almak istiyorum.`;
---

<PageLayout
  title={calculator.title}
  description={calculator.summary}
  path={path}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <slot name="head" slot="head" />

  <PageHero eyebrow="Hesaplama Aracı" title={calculator.title} lead={calculator.summary}>
    <Breadcrumbs slot="before" items={crumbs} />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="tool">
        <div class="tool__form">
          <h2 class="tool__form-title">{formTitle}</h2>
          <slot name="form" />
        </div>

        <div class="tool__result">
          <slot />

          <p class="tool__asof">
            Hesap, <strong>{lawAsOf}</strong> tarihinde yürürlükte olan mevzuata göre yapılmıştır. Mevzuat
            değişmişse sonuç güncelliğini yitirmiş olabilir.
          </p>

          {scopeNote && <p class="tool__scope">{scopeNote}</p>}

          <p class="tool__disclaimer">{CALCULATOR_DISCLAIMER}</p>
        </div>
      </div>
    </div>
  </section>

  <ContactCallout title="Sonucu birlikte değerlendirelim" message={message} />
</PageLayout>

<style>
  .tool {
    display: grid;
    gap: var(--space-6);
  }

  /* ---------- Form sütunu ---------- */

  .tool__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .tool__form-title {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Sonuç sütunu ---------- */

  .tool__result {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tool__asof {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /*
   * Kapsam notu uyarının ÜSTÜNDE ve ondan bir tık daha sessiz: sırayla
   * okunduğunda önce "bu araç neyi hesaplamıyor", sonra "hesapladığı da
   * bağlayıcı değil" geliyor. İkisi aynı ağırlıkta olsaydı yarışırlardı.
   */
  .tool__scope {
    padding: var(--space-4);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  /*
   * Uyarı, sayfanın en sessiz metni değil: sol kenardaki lacivert şerit onu
   * gövde metninden ayırıyor. Reklam yasağı açısından görülmesi gereken bir
   * metin, gri dipnot muamelesi görmemeli.
   */
  .tool__disclaimer {
    padding: var(--space-4);
    background-color: var(--bg-secondary);
    border-inline-start: 3px solid var(--brand-navy);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  /* ---------- Geniş ekran ---------- */

  @media (min-width: 1024px) {
    .tool {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    /*
     * Form sabitleniyor: cetvel uzun olduğunda kullanıcı sonucu okurken
     * girdileri de görebilsin, değeri değiştirmek için yukarı kaydırmak
     * zorunda kalmasın.
     */
    .tool__form {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
    }
  }
</style>
