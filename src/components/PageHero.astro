---
/**
 * Sayfa başlığı bloğu — ana sayfa dışındaki tüm sayfaların açılışı.
 * Tek bir yerde durması, sayfalar arası dikey ritmin kaymamasını sağlar.
 */

interface Props {
  /** Başlığın üstündeki küçük etiket (ör. "Çalışma Alanı"). */
  eyebrow?: string;
  title: string;
  /** Başlığın altındaki tanıtıcı cümle. */
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <slot name="before" />
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 class="page-hero__title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-6);
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .page-hero__eyebrow {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .page-hero__title {
    max-width: 20ch;
  }

  .page-hero__lead {
    max-width: 58ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
</style>
