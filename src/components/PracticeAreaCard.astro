---
/**
 * Çalışma alanı kartı.
 *
 * Kartın TAMAMI bağlantıdır (başlıktaki küçük bir link değil): dokunmatik
 * ekranda hedef alanı büyütür ve klavyeyle gezinirken kart başına tek durak
 * oluşur. Başlık ayrıca başlık etiketi olarak kalır ki sayfanın başlık
 * hiyerarşisi bozulmasın.
 *
 * GÖRSEL ALANI: Konu başlığına ilişkin stok görsel için hazır. Görsel
 * verilmezse kart görselsiz olarak TAM ve düzgün görünür — boş bir yer
 * tutucu kutu bırakılmaz. Görsel geldiğinde yükseklik aspect-ratio ile
 * rezerve edildiği için düzen kaymaz (CLS = 0).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AreaIcon from './icons/AreaIcon.astro';

interface Props {
  href: string;
  /**
   * Çalışma alanı slug'ı — ikonu seçer. `href`ten türetilmiyor çünkü adres
   * yapısı değişirse ikon sessizce kaybolur; ayrı prop bunu görünür kılar.
   */
  area: string;
  title: string;
  summary: string;
  /** Kart görseli. Koleksiyon şemasındaki `image()` alanından gelir. */
  image?: ImageMetadata;
  /** Dekoratif stok görselde boş bırakılır — gerekçe için content.config.ts. */
  imageAlt?: string;
  /** Başlık düzeyi — kullanıldığı sayfanın hiyerarşisine göre ayarlanır. */
  headingLevel?: 'h2' | 'h3';
}

const { href, area, title, summary, image, imageAlt = '', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a class="area-card" href={href}>
  {
    image && (
      <div class="area-card__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 92vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="area-card__body">
    {
      /*
      Düz <div> ile sarmalanıyor: Astro'nun kapsamlı stilleri alt BİLEŞENİN
      kök öğesine ulaşmaz, dolayısıyla sınıfı doğrudan <AreaIcon>'a vermek
      stilsiz bırakırdı (bu tuzağa bu projede daha önce üç kez düşüldü).

      label verilmiyor: başlık zaten alanın adını söylüyor, ekran okuyucu
      aynı bilgiyi iki kez okumasın diye ikon aria-hidden kalıyor.
    */
    }
    <div class="area-card__icon">
      <AreaIcon area={area} size={40} />
    </div>

    <Heading class="area-card__title">{title}</Heading>
    <p class="area-card__summary">{summary}</p>
    <span class="area-card__more" aria-hidden="true">Ayrıntı →</span>
  </div>
</a>

<style>
  .area-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden; /* görsel köşeleri kartın yuvarlağına uysun */
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .area-card:hover {
    border-color: var(--brand-navy);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  /* Hareket hassasiyeti olan kullanıcıda kart zıplamasın */
  @media (prefers-reduced-motion: reduce) {
    .area-card:hover {
      transform: none;
    }
  }

  /* ---------- Görsel ---------- */

  .area-card__media {
    /* Yükseklik önceden rezerve: görsel yüklenince metin aşağı kaymaz. */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .area-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Gövde ---------- */

  .area-card__body {
    display: flex;
    flex-direction: column;
    flex: 1; /* görselsiz ve görselli kartlar aynı yükseklikte hizalanır */
    padding: var(--space-5);
  }

  .area-card__icon {
    margin-bottom: var(--space-4);
    color: var(--brand-navy);
  }

  .area-card__title {
    font-size: var(--text-xl);
    color: var(--brand-navy);
  }

  .area-card__summary {
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .area-card__more {
    /* auto üst boşluk: özet kısa olsa da "Ayrıntı" bağlantısı kartın
       altına sabitlenir, ızgaradaki kartlar hizalı görünür. */
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-navy);
  }
</style>
