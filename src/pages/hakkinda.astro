---
/**
 * Hakkında sayfası.
 *
 * KAPSAM — BİLİNÇLİ OLARAK KISA:
 * Av. Onur Can Yılmaz ayrıntılı bir özgeçmiş sayfası istemedi. Sayfa tek
 * paragraflık bir özet, çalışma alanları listesi ve büro bilgilerinden oluşur.
 * ONURCANYILMAZ-CV.pdf'teki mesleki geçmiş, eğitim ayrıntısı ve çalışma
 * yaklaşımı anlatımı bu nedenle sayfadan ÇIKARILDI — eksik kalmış değil,
 * istenmediği için yok. Yeniden eklenmesi istenirse CV kaynak alınmalı.
 *
 * Talimatla dışarıda bırakılanlar: önceki işveren adı, mesleğe başlama
 * tarihi veya herhangi bir yıl/süre bilgisi, teknoloji girişimi kaydı.
 *
 * ÇALIŞMA ALANI SIRASI: Özet cümlesinde ceza hukuku ilk sırada anılıyor.
 * Sayfanın önceki hâli "ağırlıklı olarak özel hukuk" diyordu ve ceza
 * hukukunu dışarıda bırakıyordu; büro bu alanda da çalıştığı için cümle
 * yedi çalışma alanının tamamını kapsayacak biçimde yeniden yazıldı.
 *
 * Reklam yasağı (Avukatlık Kanunu m.55 / TBB Reklam Yasağı Yönetmeliği —
 * CLAUDE.md Bölüm 4/3): "uzman" nitelemesi, başarı oranı, müvekkil adı veya
 * üstünlük iddiası yok.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCallout from '../components/ContactCallout.astro';
import { ATTORNEY, CONTACT, LANGUAGES, OFFICE_HOURS } from '../lib/site';
import { getPracticeAreas, practiceAreaPath } from '../lib/practice-areas';
import { breadcrumbSchema, type BreadcrumbItem } from '../lib/schema';

const practiceAreas = await getPracticeAreas();

const crumbs: BreadcrumbItem[] = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Hakkında', path: '/hakkinda' },
];

/*
 * Özet paragrafı tek bir şablon değişmezi olarak kuruluyor.
 * Gerekçe: şablonda alt alta yazılan iki ifadenin arasındaki satır sonunu
 * Astro yutuyor ve "kayıtlıdır.Ceza" gibi bitişik metin çıkıyor. Cümlenin
 * tamamı tek ifade olduğunda boşluklar metnin kendisine ait olur.
 */
const summary =
  `${ATTORNEY.name}, Hacettepe Üniversitesi Hukuk Fakültesi mezunudur ve ` +
  `${ATTORNEY.bar}'na ${ATTORNEY.barRegistrationNumber} sicil numarasıyla kayıtlıdır. ` +
  'Ceza hukuku ile ticaret ve şirketler, gayrimenkul, icra ve iflas, sigorta, girişim ve ' +
  'fikri mülkiyet hukuku alanlarında danışmanlık ve dava takibi yürütmektedir.';

const description = `${ATTORNEY.title} ${ATTORNEY.name} — ${ATTORNEY.bar} Sicil No: ${ATTORNEY.barRegistrationNumber}. Ceza, ticaret, gayrimenkul, icra-iflas ve sigorta hukuku alanlarında Ankara Çankaya'da faaliyet göstermektedir.`;
---

<PageLayout
  title="Hakkında"
  description={description}
  path="/hakkinda"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Hakkında"
    title={`${ATTORNEY.title} ${ATTORNEY.name}`}
    lead={`${ATTORNEY.bar}'na kayıtlı olarak Ankara Çankaya'da avukatlık yapmaktadır.`}
  >
    <Breadcrumbs slot="before" items={crumbs} />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="layout">
        <div class="layout__main">
          <div class="prose">
            <p>{summary}</p>
          </div>

          <h2 class="block-title">Çalışma alanları</h2>
          <ul class="area-list">
            {
              practiceAreas.map((area) => (
                <li>
                  <a href={practiceAreaPath(area.id)}>{area.data.title}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="card" aria-labelledby="kimlik">
          <h2 class="block-title" id="kimlik">Büro bilgileri</h2>
          <dl class="facts">
            <dt>Unvan</dt>
            <dd>{ATTORNEY.title}</dd>

            <dt>Baro</dt>
            <dd>{ATTORNEY.bar}</dd>

            <dt>Sicil No</dt>
            <dd>{ATTORNEY.barRegistrationNumber}</dd>

            <dt>Adres</dt>
            <dd>{CONTACT.address.full}</dd>

            <dt>Çalışma saatleri</dt>
            <dd>{OFFICE_HOURS.display}</dd>

            <dt>Diller</dt>
            {
              /* Hizmet dili işaretleniyor: İngilizce ve Gürcüce biliniyor ama
                site ve hizmet şu an Türkçe yürüyor, yanlış beklenti doğmasın. */
            }
            <dd>
              {
                LANGUAGES.map((language, index) => (
                  <>
                    {index > 0 && ' · '}
                    {language.name}
                    {language.service && <span class="facts__note"> (hizmet dili)</span>}
                  </>
                ))
              }
            </dd>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <ContactCallout />
</PageLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-7);
  }

  .block-title {
    margin-top: var(--space-6);
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  /* Yan karttaki başlık, ana başlıklarla aynı ağırlıkta olmamalı —
     çalışma alanı sayfalarındaki yan sütunla aynı dil. */
  .card .block-title {
    margin-top: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .area-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .area-list li {
    border-bottom: 1px solid var(--border);
  }

  .area-list a {
    display: block;
    padding-block: var(--space-3);
    text-decoration: none;
  }

  .area-list a:hover {
    text-decoration: underline;
  }

  .card {
    align-self: start;
    padding: var(--space-5);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .facts dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .facts__note {
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-8);
    }
  }
</style>
