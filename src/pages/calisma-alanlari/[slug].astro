---
/**
 * Tek bir çalışma alanı sayfası — koleksiyondaki her Markdown dosyası için
 * derleme sırasında statik olarak üretilir.
 */
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCallout from '../../components/ContactCallout.astro';
import { getPracticeAreas, practiceAreaPath, type PracticeArea } from '../../lib/practice-areas';
import { calculatorsForArea } from '../../lib/calculators';
import { breadcrumbSchema, serviceSchema, type BreadcrumbItem } from '../../lib/schema';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const areas = await getPracticeAreas();
  return areas.map((area) => ({
    params: { slug: area.id },
    props: { area },
  }));
}

interface Props {
  area: PracticeArea;
}

const { area } = Astro.props;
const { Content } = await render(area);

const path = practiceAreaPath(area.id);
const url = new URL(path, SITE.url).href;

const crumbs: BreadcrumbItem[] = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Çalışma Alanları', path: '/calisma-alanlari' },
  { name: area.data.title, path },
];

const tools = calculatorsForArea(area.id);

const schemas = [
  serviceSchema({ name: area.data.title, description: area.data.description, url }),
  breadcrumbSchema(crumbs),
];

// WhatsApp sohbetine hangi alandan yazıldığı önceden yazılır — gelen mesajın
// hangi konuda olduğu ilk bakışta belli olsun.
const message = `Merhaba, ${area.data.title} alanında bilgi almak istiyorum.`;
---

<PageLayout
  title={area.data.title}
  description={area.data.description}
  path={path}
  schemas={schemas}
>
  <PageHero eyebrow="Çalışma Alanı" title={area.data.title} lead={area.data.summary}>
    <Breadcrumbs slot="before" items={crumbs} />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="layout">
        <div class="layout__main">
          <div class="prose"><Content /></div>

          <h2 class="block-title" id="isler">Ele alınan başlıca işler</h2>
          <ul class="matter-list" aria-labelledby="isler">
            {area.data.matters.map((matter) => <li>{matter}</li>)}
          </ul>
        </div>

        <aside class="layout__side" aria-labelledby="mevzuat">
          <h2 class="block-title" id="mevzuat">Dayanak mevzuat</h2>
          <ul class="law-list">
            {
              area.data.laws.map((law) => (
                <li class="law-list__item">
                  <span class="law-list__code">{law.code} sayılı</span>
                  <span class="law-list__name">{law.name}</span>
                </li>
              ))
            }
          </ul>

          {
            tools.length > 0 && (
              <div class="tools">
                <h2 class="block-title" id="araclar">
                  İlgili hesaplama araçları
                </h2>
                <ul class="tool-list" aria-labelledby="araclar">
                  {tools.map((tool) => (
                    <li class="tool-list__item">
                      {tool.status === 'ready' ? (
                        <a href={`/hesaplama-araclari/${tool.slug}`}>{tool.title}</a>
                      ) : (
                        <>
                          <span>{tool.title}</span>
                          <span class="tool-list__status">Hazırlanıyor</span>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </section>

  <ContactCallout title={`${area.data.title} hakkında görüşelim`} message={message} />
</PageLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-7);
  }

  .block-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .layout__main .block-title {
    margin-top: var(--space-7);
  }

  /*
   * Yan sütun başlıkları ana başlıklarla yarışmamalı: serif/xl yerine
   * footer sütun başlıklarıyla aynı dil — küçük, harf aralıklı, büyük harf.
   * "İlgili hesaplama araçları" xl boyutta iki satıra kırılıyordu.
   */
  .layout__side .block-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Ele alınan işler ---------- */

  .matter-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .matter-list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  /* ---------- Yan sütun ---------- */

  .layout__side {
    padding: var(--space-5);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    /* Sayfa kaydırıldıkça mevzuat listesi görünürde kalsın */
    align-self: start;
  }

  .law-list,
  .tool-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .law-list__item {
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
  }

  .law-list__code {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .law-list__name {
    color: var(--text-primary);
  }

  .tools {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-strong);
  }

  .tool-list__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .tool-list__status {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-8);
    }

    .layout__side {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
    }
  }
</style>
