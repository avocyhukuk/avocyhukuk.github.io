---
/**
 * Ana sayfa.
 *
 * HERO = VİDEO ALANI. Av. Onur Can Yılmaz'ın kararı: site açıldığında ilk
 * görülen öğe, buraya eklenecek animasyon olacak. Bu yüzden video alanı
 * metnin YANINDA yarım sütunda değil, metnin ÜSTÜNDE ve kenardan kenara
 * (full-bleed) duruyor; başlık ve çağrılar hemen altında geliyor.
 *
 * Oran, animasyon ekranın tamamını yiyip başlığı katlamanın altına itmesin
 * diye masaüstünde 21/9'a geçer (bkz. --video-aspect-hero). Yükseklik
 * aspect-ratio ile şimdiden rezerve edildiği için animasyon eklendiğinde
 * düzen kaymaz — CLAUDE.md Bölüm 4/2.
 *
 * Açılış metninin tezi: bu büronun ayırt edici yanı, ziyaretçiye somut bir
 * çıktı vermesi — yedi tanımlı çalışma alanı ve hesaplama araçları.
 *
 * Metinler salt tanıtıcıdır: üstünlük iddiası, başarı oranı veya müvekkil
 * referansı içermez (Avukatlık Kanunu m.55 — CLAUDE.md Bölüm 4/3).
 */
import PageLayout from '../layouts/PageLayout.astro';
import VideoSlot from '../components/VideoSlot.astro';
import PracticeAreaCard from '../components/PracticeAreaCard.astro';
import ContactCallout from '../components/ContactCallout.astro';
import { ATTORNEY, SITE } from '../lib/site';
import { getPracticeAreas, practiceAreaPath } from '../lib/practice-areas';
import { CALCULATORS } from '../lib/calculators';
import { attorneySchema } from '../lib/schema';

const practiceAreas = await getPracticeAreas();

// Attorney şeması yalnızca ana sayfada tanımlanır; diğer sayfalar @id ile
// bu düğüme atıf yapar (bkz. src/lib/schema.ts).
const schemas = [attorneySchema()];

const title = `${SITE.name} — Ankara`;
const description =
  'Ankara Çankaya merkezli hukuk bürosu. Ceza, ticaret, gayrimenkul, icra-iflas, ' +
  'sigorta, girişim ve fikri mülkiyet hukukunda danışmanlık ve dava takibi.';
---

<PageLayout title={title} description={description} path="/" schemas={schemas}>
  <section class="hero">
    {/* Konteynerin DIŞINDA: kenardan kenara uzanması için */}
    <div class="hero__video">
      <VideoSlot title="OCY Hukuk & Danışmanlık tanıtımı" variant="hero" />
    </div>

    <div class="container hero__text">
      <p class="hero__eyebrow">
        {`${ATTORNEY.title} ${ATTORNEY.name}`} · {ATTORNEY.bar} Sicil No: {
          ATTORNEY.barRegistrationNumber
        }
      </p>
      <h1 class="hero__title">Ankara'da hukuki danışmanlık ve dava takibi</h1>
      <p class="hero__lead">
        Yedi çalışma alanında danışmanlık ve dava takibi yürütülmektedir. Sık karşılaşılan
        hesaplamalar için — infaz süresi, araç değer kaybı, kira artışı, icra faizi — dayandığı
        kanun maddesini gösteren hesaplama araçları hazırlanmaktadır.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/calisma-alanlari">Çalışma alanları</a>
        <a class="btn btn--secondary" href="/iletisim">İletişim</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="alanlar-baslik">
    <div class="container">
      <div class="section-head">
        <h2 id="alanlar-baslik">Çalışma Alanları</h2>
        <p class="section-head__desc">
          Her alanın kendi sayfasında ele alınan başlıca işler ve dayanak mevzuat yer alır.
        </p>
      </div>

      <ul class="area-grid">
        {
          practiceAreas.map((area) => (
            <li>
              <PracticeAreaCard
                href={practiceAreaPath(area.id)}
                area={area.id}
                title={area.data.title}
                summary={area.data.summary}
                image={area.data.image}
                imageAlt={area.data.imageAlt}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="araclar-baslik">
    <div class="container">
      <div class="section-head">
        <h2 id="araclar-baslik">Hesaplama Araçları</h2>
        <p class="section-head__desc">
          Her aracın sonucunda dayandığı kanun maddesi gösterilir. Araçlar hazırlanma aşamasındadır.
        </p>
      </div>

      <ul class="tool-list">
        {
          CALCULATORS.map((calculator) => (
            <li class="tool-list__item">
              <span class="tool-list__title">{calculator.title}</span>
              <span class="tool-list__status">
                {calculator.status === 'ready' ? 'Kullanılabilir' : 'Hazırlanıyor'}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="tool-note">
        Hesaplama sonuçları tahminidir ve bilgilendirme amaçlıdır; somut olayınız için hukuki
        değerlendirme gereklidir.
      </p>

      <a class="btn btn--secondary tool-cta" href="/hesaplama-araclari">Araçlara göz atın</a>
    </div>
  </section>

  <section class="section" aria-labelledby="hakkinda-baslik">
    <div class="container container--narrow">
      <h2 id="hakkinda-baslik">Büro Hakkında</h2>
      <p class="prose">
        {`${ATTORNEY.title} ${ATTORNEY.name}`}, {ATTORNEY.bar}'na kayıtlı olarak Ankara Çankaya'da
        faaliyet göstermektedir. Büro; ceza, ticaret ve şirketler, gayrimenkul, icra ve iflas,
        sigorta, girişim ile fikri mülkiyet hukuku alanlarında danışmanlık ve dava takibi hizmeti
        vermektedir.
      </p>
      <a class="text-link" href="/hakkinda">Hakkında sayfasına gidin →</a>
    </div>
  </section>

  <ContactCallout />
</PageLayout>

<style>
  /* ---------- Açılış ---------- */

  .hero {
    /* Üstte boşluk yok: video alanı doğrudan başlığın altından başlasın */
    padding-bottom: var(--section-y);
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .hero__text {
    padding-top: var(--space-6);
  }

  .hero__eyebrow {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__title {
    max-width: 18ch;
  }

  .hero__lead {
    max-width: 56ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* ---------- Bölüm başlıkları ---------- */

  .section-head {
    margin-bottom: var(--space-6);
  }

  .section-head__desc {
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  /* ---------- Çalışma alanı ızgarası ---------- */

  .area-grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Araç listesi ---------- */

  .tool-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .tool-list__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .tool-list__title {
    font-weight: 500;
  }

  .tool-list__status {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tool-note {
    max-width: 62ch;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .tool-cta {
    margin-top: var(--space-5);
  }

  /* ---------- Hakkında ---------- */

  .prose {
    margin-block: var(--space-4);
  }

  .text-link {
    font-weight: 600;
  }

  /* ---------- Genişleme ---------- */

  @media (min-width: 640px) {
    .area-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .area-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
