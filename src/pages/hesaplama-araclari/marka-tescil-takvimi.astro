---
/**
 * Marka Tescil Süreç Takvimi.
 *
 * Aşamalar ve kaynaklar: docs/hesaplama-formulleri.md § 8.
 * Tarih hesabı src/lib/marka-takvimi.ts içinde, saf ve test edilmiş.
 *
 * ─── SEKİZ ARAÇ İÇİNDE TEK "CETVELSİZ" ARAÇ ───────────────────────────
 * Sonuç bir para dökümü olmadığı için `ResultSheet` kullanılmıyor; yerine
 * zaman çizelgesi var. Kabuk yine ortak: uyarı, kapsam notu, mevzuat
 * tarihi ve iletişim bloğu oradan geliyor.
 *
 * ─── DÜZEN KAYMASI YOK ────────────────────────────────────────────────
 * CLAUDE.md Bölüm 4/2, video alanı için "yüksekliği önceden rezerve et"
 * diyor. Buradaki karşılığı: aşama iskeleti (adlar, süreler, açıklamalar,
 * kanun maddeleri) SUNUCUDA basılıyor, betik yalnızca tarih alanlarını
 * dolduruyor. Böylece hesaplama sayfanın yüksekliğini değiştirmiyor ve
 * JS kapalı kullanıcı da süreci baştan sona okuyabiliyor.
 */
import CalculatorShell from '../../components/calculator/CalculatorShell.astro';
import FormField from '../../components/calculator/FormField.astro';
import { CALCULATORS } from '../../lib/calculators';
import { uniqueReferences } from '../../lib/calculator-ui';
import { ASAMALAR, ITIRAZLI_SURE, type Sure } from '../../lib/marka-asamalari';

const calculator = CALCULATORS.find((tool) => tool.slug === 'marka-tescil-takvimi')!;

const scopeNote = [
  "Bu süreler TÜRKPATENT'in tipik işlem sürelerine dayanan tahminlerdir, kurumun güncel iş yüküne göre değişebilir, resmi bir garanti içermez.",
  'Aşamalardan yalnızca Bültende yayım ve itiraz süresi kanunda yazılıdır; diğerleri kurumun tipik işlem sürelerinden derlenmiştir ve dosyadan dosyaya değişir.',
];

/** "2 hafta – 4 ay" · eşitse "2 ay". */
function sureMetni(min: Sure, max: Sure): string {
  const yaz = (s: Sure) => `${s.deger} ${s.birim}`;
  return min.deger === max.deger && min.birim === max.birim
    ? yaz(min)
    : `${yaz(min)} – ${yaz(max)}`;
}

// Dayanak listesi sunucuda basılıyor — JS olmadan da görünür.
const dayanaklar = uniqueReferences(
  ASAMALAR.map((asama) => ({ label: asama.ad, value: '', basis: asama.dayanak }))
);
---

<CalculatorShell
  calculator={calculator}
  lawAsOf="21 Eylül 2026"
  scopeNote={scopeNote}
  formTitle="Başvuru tarihini girin"
>
  <Fragment slot="form">
    <FormField
      id="basvuru"
      label="Marka başvurusu tarihi"
      hint="TÜRKPATENT'e başvurunun yapıldığı gün."
      type="date"
    />

    <button class="btn btn--primary" type="button" id="hesapla">Takvimi oluştur</button>

    <p class="form-note">
      Aşamalar ve süreleri aşağıda hazır durur; tarih girildiğinde her aşamanın beklenen tarih
      aralığı doldurulur.
    </p>
  </Fragment>

  <div class="result-region">
    <p class="alert" id="uyari" role="alert" hidden></p>

    <section class="dal" aria-labelledby="dal-itirazsiz">
      <h2 class="dal__baslik" id="dal-itirazsiz">İtiraz gelmezse</h2>

      <ol class="cizelge">
        {
          ASAMALAR.map((asama, sira) => (
            <li class:list={['asama', { 'asama--kesin': asama.kesin }]}>
              <span class="asama__no" aria-hidden="true">
                {sira + 1}
              </span>

              <div class="asama__govde">
                <h3 class="asama__ad">{asama.ad}</h3>

                <p class="asama__sure">
                  {sureMetni(asama.min, asama.max)}
                  {asama.kesin && <span class="asama__rozet">kanuni süre</span>}
                </p>

                {/* Betiğin dolduracağı tek alan. Yer tutucu "—" yüksekliği
                    baştan rezerve ediyor, hesap sonrası düzen kaymıyor. */}
                <p class="asama__tarih" data-asama={sira}>
                  —
                </p>

                <p class="asama__aciklama">{asama.aciklama}</p>
                <span class="asama__dayanak">{asama.dayanak.short}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="dal" aria-labelledby="dal-itirazli">
      <h2 class="dal__baslik" id="dal-itirazli">İtiraz gelirse</h2>

      <div class="itirazli">
        <p class="asama__sure">{sureMetni(ITIRAZLI_SURE.min, ITIRAZLI_SURE.max)}</p>
        <p class="asama__tarih" data-itirazli>—</p>
        <p class="asama__aciklama">
          Yayıma itiraz edilirse süreç itirazın incelenmesiyle uzar. Karara itiraz ve Yeniden
          İnceleme ve Değerlendirme Kurulu aşamaları dosyaya göre değiştiği için bu dal aşamalara
          bölünmemiştir.
        </p>
      </div>
    </section>

    <div class="dayanaklar">
      <h2 class="dayanaklar__baslik">Dayanak mevzuat</h2>
      <ul class="dayanaklar__liste">
        {dayanaklar.map((dayanak) => <li>{dayanak.full}</li>)}
      </ul>
    </div>
  </div>
</CalculatorShell>

<style>
  .form-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .result-region {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .alert {
    padding: var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-inline-start: 3px solid var(--text-primary);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .dal__baslik {
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Zaman çizelgesi ---------- */

  .cizelge {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Sıra sütunu sabit genişlikte; numaraların arasından geçen dikey çizgi
   * aşamaları birbirine bağlıyor. Çizgi son aşamada bitiyor — süreç orada
   * bitiyor, çizelge boşluğa uzamıyor.
   */
  .asama {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .asama:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-block: 2rem 0;
    inset-inline-start: 1rem;
    width: 1px;
    background-color: var(--border-strong);
  }

  .asama__no {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--brand-navy);
  }

  /* Kanuni süre olan aşama dolu daireyle ayrılıyor: diğerleri tahmin, bu değil. */
  .asama--kesin .asama__no {
    background-color: var(--brand-navy);
    border-color: var(--brand-navy);
    color: var(--text-on-navy);
  }

  .asama__ad {
    font-size: var(--text-base);
    color: var(--brand-navy);
  }

  .asama__sure {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .asama__rozet {
    margin-inline-start: var(--space-2);
    padding: 0.1em 0.5em;
    background-color: var(--brand-navy);
    border-radius: var(--radius-sm);
    color: var(--text-on-navy);
  }

  /*
   * Tarih satırı, değer gelmeden de yer kaplasın diye min-height taşıyor.
   * Hesaplama öncesi "—", sonrası "12 Mayıs 2026 – 15 Şubat 2027".
   *
   * Ölçü mobilde bilinçli olarak `--text-base`: `--text-lg` ile en uzun
   * aralık (29 karakter) 360px altındaki ekranlarda ikinci satıra
   * kırılıyor ve tarih dolduğunda çizelge aşağı kayıyordu — tam da
   * önlemek istediğimiz şey. Yer açılınca, 640px üstünde büyüyor.
   */
  .asama__tarih {
    min-height: 1.6em;
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .asama__tarih {
      font-size: var(--text-lg);
    }
  }

  .asama__aciklama {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .asama__dayanak {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--brand-navy);
  }

  /* ---------- İtirazlı dal ---------- */

  .itirazli {
    padding: var(--space-5);
    background-color: var(--bg-secondary);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  /* ---------- Dayanak listesi ---------- */

  .dayanaklar {
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .dayanaklar__baslik {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .dayanaklar__liste {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
</style>

<script>
  import { markaTakvimiHesapla } from '../../lib/marka-takvimi';
  import { formatDateTR } from '../../lib/format';

  const el = <T extends HTMLElement>(id: string) => document.querySelector<T>(`#${id}`);

  const basvuru = el<HTMLInputElement>('basvuru');
  const buton = el<HTMLButtonElement>('hesapla');
  const uyari = el<HTMLElement>('uyari');
  const itirazliAlan = document.querySelector<HTMLElement>('[data-itirazli]');

  if (basvuru && buton && uyari && itirazliAlan) {
    const asamaAlanlari = [...document.querySelectorAll<HTMLElement>('[data-asama]')];

    const aralik = (enErken: Date, enGec: Date) =>
      `${formatDateTR(enErken)} – ${formatDateTR(enGec)}`;

    /** Tarihleri yer tutucuya döndürür — çizelge iskeleti yerinde kalır. */
    const temizle = () => {
      for (const alan of asamaAlanlari) alan.textContent = '—';
      itirazliAlan.textContent = '—';
    };

    const uyariGoster = (mesaj: string) => {
      uyari.textContent = mesaj;
      uyari.hidden = false;
      temizle();
    };

    const hesapla = () => {
      uyari.hidden = true;

      // `type="date"` değeri `yyyy-mm-dd`; bu biçim UTC gece yarısı olarak
      // ayrıştırılır, dolayısıyla saat dilimi kayması olmaz.
      const sonuc = markaTakvimiHesapla(new Date(basvuru.value));

      if (sonuc.durum === 'gecersiz-tarih') {
        uyariGoster('Geçerli bir başvuru tarihi girin.');
        return;
      }
      if (sonuc.durum === 'smk-oncesi') {
        uyariGoster(
          `Bu araç ${formatDateTR(sonuc.yururluk)} ve sonrasındaki başvurular için tahmin yapar; ` +
            'daha eski başvurular 556 sayılı Kanun Hükmünde Kararname rejimine tabidir.'
        );
        return;
      }

      sonuc.asamalar.forEach((asama, sira) => {
        const alan = asamaAlanlari[sira];
        if (alan) alan.textContent = aralik(asama.enErken, asama.enGec);
      });

      itirazliAlan.textContent = aralik(sonuc.itirazli.enErken, sonuc.itirazli.enGec);
    };

    buton.addEventListener('click', hesapla);

    basvuru.addEventListener('keydown', (olay) => {
      if (olay.key === 'Enter') {
        olay.preventDefault();
        hesapla();
      }
    });
  }
</script>
