---
/**
 * Hesaplama araçları liste sayfası.
 *
 * Araçların kendisi Faz C'de geliştirilecek. Bu sayfa şimdiden yayında çünkü
 * ana menüde bağlantısı var ve kırık bağlantı bırakmak istemiyoruz. Hazır
 * olmayan araçlar "Hazırlanıyor" olarak DÜRÜSTÇE işaretleniyor — sahte bir
 * bağlantı verilmiyor.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCallout from '../../components/ContactCallout.astro';
import { CALCULATORS, hasReadyCalculators } from '../../lib/calculators';
import { CALCULATOR_DISCLAIMER } from '../../lib/site';
import { breadcrumbSchema, type BreadcrumbItem } from '../../lib/schema';

const crumbs: BreadcrumbItem[] = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Hesaplama Araçları', path: '/hesaplama-araclari' },
];

const description =
  'İnfaz süresi, araç değer kaybı, kira artış oranı ve icra faizi gibi sık karşılaşılan hesaplamalar için dayanağı gösterilen araçlar.';

const anyReady = hasReadyCalculators();
---

<PageLayout
  title="Hesaplama Araçları"
  description={description}
  path="/hesaplama-araclari"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Hesaplama Araçları"
    lead="Her aracın sonucunda dayandığı kanun maddesi gösterilir. Sonuçlar tahminidir; bağlayıcı bir hukuki değerlendirme yerine geçmez."
  >
    <Breadcrumbs slot="before" items={crumbs} />
  </PageHero>

  <section class="section">
    <div class="container">
      {
        !anyReady && (
          <p class="status-note">
            Araçlar geliştirme aşamasındadır. Her aracın formülü ve dayanağı, yayına alınmadan önce
            doğrulanmaktadır.
          </p>
        )
      }

      <ul class="tool-grid">
        {
          CALCULATORS.map((tool) => (
            <li>
              {tool.status === 'ready' ? (
                <a class="tool-card" href={`/hesaplama-araclari/${tool.slug}`}>
                  <h2 class="tool-card__title">{tool.title}</h2>
                  <p class="tool-card__summary">{tool.summary}</p>
                  <span class="tool-card__more" aria-hidden="true">
                    Hesapla →
                  </span>
                </a>
              ) : (
                /* Hazır olmayan araç bağlantı DEĞİL: tıklanabilir görünüp
                   hiçbir yere gitmeyen bir öğe bırakmamak için <div>. */
                <div class="tool-card tool-card--pending">
                  <h2 class="tool-card__title">{tool.title}</h2>
                  <p class="tool-card__summary">{tool.summary}</p>
                  <span class="tool-card__status">Hazırlanıyor</span>
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <p class="disclaimer">{CALCULATOR_DISCLAIMER}</p>
    </div>
  </section>

  <ContactCallout
    title="Hesaplama sonucunuzu birlikte değerlendirelim"
    message="Merhaba, hesaplama araçlarıyla ilgili bilgi almak istiyorum."
  />
</PageLayout>

<style>
  .status-note {
    max-width: 60ch;
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background-color: var(--bg-secondary);
    border-inline-start: 3px solid var(--brand-navy);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .tool-grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  a.tool-card:hover {
    border-color: var(--brand-navy);
    box-shadow: var(--shadow);
  }

  /* Hazır olmayan kart görsel olarak da geri çekilir — tıklanabilir sanılmasın */
  .tool-card--pending {
    background-color: transparent;
    border-style: dashed;
  }

  .tool-card__title {
    font-size: var(--text-lg);
    color: var(--brand-navy);
  }

  .tool-card__summary {
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .tool-card--pending .tool-card__summary {
    color: var(--text-muted);
  }

  .tool-card__more {
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-navy);
  }

  .tool-card__status {
    margin-top: auto;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .disclaimer {
    max-width: 66ch;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tool-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
