---
/**
 * 404 sayfası.
 *
 * noindex: hatalı adresin arama sonuçlarına girmesini engeller.
 * Boş bir "bulunamadı" ekranı yerine ziyaretçiyi ana bölümlere yönlendirir —
 * kullanıcı çoğunlukla aradığını başka bir başlıkta bulur.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { NAV_LINKS } from '../lib/site';

const links = NAV_LINKS.filter((link) => link.href !== '/');
---

<PageLayout title="Sayfa bulunamadı" path="/404" noindex>
  <PageHero
    eyebrow="404"
    title="Aradığınız sayfa bulunamadı"
    lead="Adres değişmiş veya sayfa kaldırılmış olabilir."
  />

  <section class="section">
    <div class="container">
      <h2 class="block-title">Şu bölümlere göz atabilirsiniz</h2>
      <ul class="links">
        <li><a href="/">Ana Sayfa</a></li>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .block-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .links {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 32rem;
    border-top: 1px solid var(--border);
  }

  .links li {
    border-bottom: 1px solid var(--border);
  }

  .links a {
    display: block;
    padding-block: var(--space-3);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
