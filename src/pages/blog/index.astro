---
/**
 * Blog liste sayfası.
 *
 * Yazılar Faz D'de eklenecek (mevcut yazıların Markdown'a taşınması). Sayfa
 * şimdiden var çünkü ana menüde bağlantısı bulunuyor. Yazı yokken dürüst bir
 * boş durum gösterilir; sahte içerik veya "yakında" başlıklı boş kartlar yok.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCallout from '../../components/ContactCallout.astro';
import { formatDateTR } from '../../lib/format';
import { breadcrumbSchema, type BreadcrumbItem } from '../../lib/schema';

// Taslaklar yayında görünmez.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const crumbs: BreadcrumbItem[] = [
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Blog', path: '/blog' },
];

const description =
  'Mevzuat ve karar analizleri. Her hukuki değerlendirme, dayandığı kanun maddesi veya karar ile birlikte verilir.';
---

<PageLayout
  title="Blog"
  description={description}
  path="/blog"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Blog"
    title="Mevzuat ve karar analizleri"
    lead="Yazılarda her hukuki değerlendirme, dayandığı kanun maddesi veya mahkeme kararı ile birlikte verilir."
  >
    <Breadcrumbs slot="before" items={crumbs} />
  </PageHero>

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="empty">
            Yazılar hazırlanmaktadır. Bu bölümde mevzuat değişiklikleri ve mahkeme kararlarına
            ilişkin değerlendirmeler yayımlanacaktır.
          </p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post">
                <p class="post__date">
                  {/* datetime: makine tarafından okunabilir ISO biçimi */}
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatDateTR(post.data.publishedAt)}
                  </time>
                </p>
                <h2 class="post__title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="post__desc">{post.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <ContactCallout />
</PageLayout>

<style>
  .empty {
    max-width: 60ch;
    padding: var(--space-5);
    background-color: var(--bg-secondary);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
  }

  .post-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .post {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .post__date {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .post__title {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
  }

  .post__title a {
    text-decoration: none;
  }

  .post__title a:hover {
    text-decoration: underline;
  }

  .post__desc {
    max-width: 62ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
  }
</style>
